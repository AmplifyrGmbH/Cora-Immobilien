# Clean URLs: .html-Endung aus URL entfernen
RewriteEngine On

# /seite.html aufgerufen -> auf /seite umleiten (301, kein doppelter Content)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /seite angefragt -> intern seite.html ausliefern
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Eigene 404-Seite (falls vorhanden)
ErrorDocument 404 /404.html

# MIME-Typen, die aeltere Apache-Installationen nicht kennen
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType font/woff2  .woff2
</IfModule>

# Brotli (falls verfuegbar), sonst Gzip. Bilder und Fonts sind bereits komprimiert.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript image/svg+xml text/plain application/json application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain application/json application/xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/jpg         "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/avif        "access plus 1 year"
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  # Bilder: 6 Monate. Bewusst ohne "immutable", weil die Dateinamen keinen Hash
  # tragen - ein ausgetauschtes Bild soll Stammbesucher nicht ein Jahr lang verfolgen.
  <FilesMatch "\.(jpg|jpeg|png|avif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  # Schriften aendern sich nie
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
